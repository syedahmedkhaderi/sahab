{
  "@jupyterlab/application-extension:shell": {
    "startMode": "single"
  },
  "@jupyterlab/apputils-extension:themes": {
    "theme": "JupyterLab Light",
    "theme-scrollbars": true,
    "overrides": {
      "ui-font-family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "content-font-family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "code-font-family": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "code-font-size": "13px",
      "content-font-size1": "14px",
      "ui-font-size1": "13px"
    }
  },
  "@jupyterlab/notebook-extension:tracker": {
    "recordTiming": true,
    "kernelStatus": {
      "showOnStatusBar": true
    },
    "codeCellConfig": {
      "lineNumbers": false,
      "lineWrap": false
    }
  },
  "@jupyterlab/docmanager-extension:plugin": {
    "autosave": true,
    "autosaveInterval": 60
  },
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false",
    "checkForUpdates": false
  },
  "@jupyterlab/cell-toolbar-extension:plugin": {
    "toolbar": [
      {
        "name": "run-cell",
        "command": "notebook:run-cell-and-select-next",
        "icon": "ui-components:run",
        "rank": 0
      }
    ]
  }
}
