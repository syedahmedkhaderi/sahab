# Copy to .env.local and fill in. Never commit the real .env.local.

# Base URL the browser uses to reach the API.
# In development with `npm run dev`, Next.js rewrites /api/* -> backend.
# In production, set this to the actual API origin if on a different domain,
# or leave as /api if Traefik routes /api to the backend on the same domain.
NEXT_PUBLIC_API_BASE=/api

# Display name shown in the nav bar and page titles.
NEXT_PUBLIC_SITE_NAME=Sahab

# The university email domain shown as a hint on the signup page.
NEXT_PUBLIC_ALLOWED_DOMAIN=udst.edu.qa

# Backend URL used server-side in next.config.js rewrites (dev only).
# Should point to the FastAPI container/process.
BACKEND_URL=http://localhost:8000
