# ============================================================
# Sahab Platform — environment configuration (example)
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ---- Domain and exposure ----
PUBLIC_HOSTNAME=sahab.example.com
# Token from the Cloudflare Zero Trust dashboard (Strategy A). Leave blank for Strategy B.
CLOUDFLARE_TUNNEL_TOKEN=
# Email for Let's Encrypt/ACME if Traefik terminates TLS directly. Leave blank
# when Cloudflare terminates TLS (Strategy A) — ACME is then unnecessary.
ACME_EMAIL=

# ---- Database / cache ----
POSTGRES_USER=sahab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sahab
# Used by backend + worker. Host "postgres" is the compose service name.
DATABASE_URL=postgresql+psycopg://sahab:change-me-strong-password@postgres:5432/sahab
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# 32+ char random string: `openssl rand -hex 32`
JWT_SECRET=change-me-openssl-rand-hex-32
# Encrypts the SSH credentials stored for each GPU server. Changing it makes
# every stored credential unreadable — they then have to be re-entered.
SECRETS_KEY=change-me-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
ALLOWED_SIGNUP_DOMAINS=udst.edu.qa
# Optional: require admin approval before a new account becomes active
REQUIRE_ADMIN_APPROVAL=true
# Bootstrap admin (seeded on first run if not present)
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- OAuth provider (FastAPI -> JupyterHub SSO) ----
OAUTH_CLIENT_ID=jupyterhub
OAUTH_CLIENT_SECRET=change-me-oauth-secret

# ---- JupyterHub integration ----
JUPYTERHUB_API_URL=http://jupyterhub:8081/hub/api
# Generate: `openssl rand -hex 32` — must match jupyterhub_config service token
JUPYTERHUB_API_TOKEN=change-me-hub-api-token
JUPYTERHUB_PUBLIC_URL=http://jupyterhub:8000

# ---- Policy defaults ----
GPU_SESSION_MAX_MINUTES=240
IDLE_TIMEOUT_MINUTES=45
DEFAULT_USER_DISK_QUOTA_GB=50
CREDITS_PER_MINUTE_L4=1.0
CREDITS_PER_MINUTE_CPU=0.0
DEFAULT_CREDIT_GRANT=240
MAX_CONCURRENT_SESSIONS_PER_USER=1

# ---- Workspace ----
# Once a private registry is set up (bootstrap.sh does this), these become
# registry-qualified — "10.0.0.5:5000/sahab-gpu-pytorch:latest" — so the other
# GPU servers can pull them instead of rebuilding a 5 GB CUDA image each.
WORKSPACE_GPU_IMAGE=sahab-gpu-pytorch:latest
WORKSPACE_CPU_IMAGE=sahab-cpu-base:latest
DOCKER_NETWORK_NAME=sahab-network
# bridge on a single machine; overlay once other GPU servers can join.
# bootstrap.sh sets this to overlay after initialising the swarm.
DOCKER_NETWORK_DRIVER=bridge
SHARED_DATASETS_PATH=/data/shared
# Unused: workspace storage is session-scoped (a volume created for the session
# and deleted with it), so there is no per-user directory on the host.
USER_VOLUMES_PATH=/data/users

# ---- Multi-machine cluster ----
# All of these are written by scripts/bootstrap.sh; you should not need to edit
# them by hand. They exist so the backend, which has no Docker access of its own
# and should not get any, can still tell a joining machine how to join.
#
# Hostname of this machine. It is seeded as the first node in the pool.
MANAGER_NODE_NAME=
# Address other GPU servers dial to reach this one (swarm 2377, registry, API).
MANAGER_ADVERTISE_ADDR=
# Output of `docker swarm join-token -q worker`.
SWARM_WORKER_TOKEN=
# host:port of the private image registry the other machines pull from.
REGISTRY_ADDR=
REGISTRY_PORT=5000
# Base URL a joining machine posts its enrollment to. Defaults to
# https://$PUBLIC_HOSTNAME, which is right unless the machines reach Sahab at a
# different address than the public one.
NODE_ENROLL_BASE_URL=
# Where the cluster CA and nodes.json live, as seen from inside the containers.
NODE_PKI_DIR=/srv/sahab/secrets/docker-ca
NODE_MAP_PATH=/srv/sahab/secrets/nodes.json
PROMETHEUS_TARGETS_PATH=/srv/sahab/targets/nodes.json
# How long a machine's Docker API may stay unreachable before its running
# sessions are failed and its GPUs taken out of the pool.
NODE_UNREACHABLE_GRACE_SECONDS=300
# Repo a joining machine installs from.
SAHAB_REPO_URL=https://github.com/syedahmedkhaderi/sahab.git
SAHAB_BRANCH=main

# ---- Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Frontend ----
# Public base URL the browser uses to reach the API (same domain in prod)
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SITE_NAME=Sahab
# Shown on the billing page as the address to ask for more credits.
NEXT_PUBLIC_SUPPORT_EMAIL=sahab-support@udst.edu.qa

# ---- GPU busy probe ----
# The scheduler cross-checks these live readings before handing out a GPU the DB
# believes is free, so a job started outside Sahab is never overwritten.
DCGM_METRICS_URL=http://dcgm-exporter:9400/metrics
# A free GPU holding more than this much VRAM, or busier than this, is skipped.
BUSY_VRAM_MB=1024
BUSY_UTIL_PCT=30

# ---- Debug ----
# Publishes /api/docs, /api/redoc and /api/openapi.json. Leave false in production.
DEBUG=false
