# ============================================================
# Sahab Platform — environment configuration (example)
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ---- Domain and exposure ----
PUBLIC_HOSTNAME=sahab.example.com
# Token from the Cloudflare Zero Trust dashboard (Strategy A). Leave blank for Strategy B.
CLOUDFLARE_TUNNEL_TOKEN=
# Email for Let's Encrypt/ACME if Traefik terminates TLS directly. Leave blank
# when Cloudflare terminates TLS (Strategy A) — ACME is then unnecessary.
ACME_EMAIL=

# ---- Database / cache ----
POSTGRES_USER=sahab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sahab
# Used by backend + worker. Host "postgres" is the compose service name.
DATABASE_URL=postgresql+psycopg://sahab:change-me-strong-password@postgres:5432/sahab
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# 32+ char random string: `openssl rand -hex 32`
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
ALLOWED_SIGNUP_DOMAINS=udst.edu.qa
# Optional: require admin approval before a new account becomes active
REQUIRE_ADMIN_APPROVAL=true
# Bootstrap admin (seeded on first run if not present)
BOOTSTRAP_ADMIN_EMAIL=syed@udst.edu.qa
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- OAuth provider (FastAPI -> JupyterHub SSO) ----
OAUTH_CLIENT_ID=jupyterhub
OAUTH_CLIENT_SECRET=change-me-oauth-secret

# ---- JupyterHub integration ----
JUPYTERHUB_API_URL=http://jupyterhub:8081/hub/api
# Generate: `openssl rand -hex 32` — must match jupyterhub_config service token
JUPYTERHUB_API_TOKEN=change-me-hub-api-token
JUPYTERHUB_PUBLIC_URL=http://jupyterhub:8000

# ---- Policy defaults ----
GPU_SESSION_MAX_MINUTES=240
IDLE_TIMEOUT_MINUTES=45
DEFAULT_USER_DISK_QUOTA_GB=50
CREDITS_PER_MINUTE_L4=1.0
CREDITS_PER_MINUTE_CPU=0.0
DEFAULT_CREDIT_GRANT=240
MAX_CONCURRENT_SESSIONS_PER_USER=1

# ---- Workspace ----
WORKSPACE_GPU_IMAGE=sahab-gpu-pytorch:latest
WORKSPACE_CPU_IMAGE=sahab-cpu-base:latest
DOCKER_NETWORK_NAME=sahab-network
SHARED_DATASETS_PATH=/data/shared
USER_VOLUMES_PATH=/data/users

# ---- Monitoring ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Frontend ----
# Public base URL the browser uses to reach the API (same domain in prod)
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SITE_NAME=Sahab
